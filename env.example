# Base settings
PROJECT_NAME=""
LOCAL_DEV=false
PROD_DOMAIN=""
# JSON list of keys accepted in the X-API-Key header
API_KEYS=["change-me"]
# Comma-separated IPs/CIDRs of reverse proxies trusted to set X-Forwarded-For (read by uvicorn)
FORWARDED_ALLOW_IPS=127.0.0.1

# LLM stuff
GEMINI_API_KEY=""

# Telegram stuff (https://my.telegram.org/apps)
AP_ID=
API_HASH=
SESSION_STRING=""
APP_TITLE=""
SHORT_NAME=

# Telegram chat digest (optional)
# Beginning of the chat name to summarise, e.g. "Homeowners_"
CHAT_DIGEST_CHAT_NAME_PREFIX=""
# Topics the digest should focus on
CHAT_DIGEST_TOPICS=""
# Any additional instructions for the LLM
CHAT_DIGEST_EXTRA_INSTRUCTIONS=""

# alerts.in.ua api token (https://alerts.in.ua/api-request)
ALERTS_TOKEN=""
